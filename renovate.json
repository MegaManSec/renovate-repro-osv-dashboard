{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "osvVulnerabilityAlerts": true,
  "dependencyDashboard": true,
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "cases/1-vulnerability-range-floor/other/**",
    "cases/2-lockfile-update-other-importers/legacy/**",
    "cases/4-skipped-only-package-file/sibling/**"
  ],
  "packageRules": [
    {
      "description": "Security updates only for the cases/ directories",
      "matchFileNames": ["cases/**"],
      "enabled": false
    },
    {
      "description": "Routine lockfile-only updates for js-yaml in case 5",
      "matchFileNames": ["cases/5-lockfile-only-update/package.json"],
      "matchDepNames": ["js-yaml"],
      "enabled": true,
      "rangeStrategy": "update-lockfile",
      "groupName": "5-lockfile-only-update"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "groupName": "{{{parentDir}}} security",
    "minimumReleaseAge": "45 days"
  }
}
